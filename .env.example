APP_NAME=CRMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- CRMS security policy (values must be approved by the institution) ---
CRMS_ORGANISATION=
CRMS_TAGLINE="Evidence-led crime analysis"
CRMS_SUPPORT_CONTACT="your system administrator"
CRMS_REQUIRE_MFA=true
CRMS_IDLE_TIMEOUT=15
CRMS_IDLE_WARNING=60
CRMS_SESSION_ABSOLUTE_LIFETIME=720
CRMS_ACTIVATION_EXPIRE=4320
CRMS_NOTIFY_NEW_DEVICE=true
# Content Security Policy; defaults to on everywhere except APP_ENV=local.
# CRMS_CSP_ENABLED=true
AUTH_PASSWORD_TIMEOUT=900

# Production: SESSION_SECURE_COOKIE=true, SESSION_SAME_SITE=strict, APP_DEBUG=false
